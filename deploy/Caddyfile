{$BRANCHLAB_HOST} {
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "same-origin"
  }
  handle /api/github/webhook {
    request_body {
      max_size 1MB
    }
    reverse_proxy api:8765
  }
  handle {
    reverse_proxy web:3000
  }
}
